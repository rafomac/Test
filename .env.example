# ---- Dashboard access (required in production) ----
# Generate with: npm run hash-password -- "your dashboard password"
APP_PASSWORD_HASH=
# openssl rand -base64 48
SESSION_SECRET=
# 32 bytes, base64: openssl rand -base64 32   (encrypts the Kite access token at rest)
ENCRYPTION_KEY=

# ---- Zerodha Kite Connect (read-only use) ----
# From https://developers.kite.trade -> My apps. Redirect URL must be https://<host>/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# ---- Storage (optional) ----
# DATA_DIR=./data          # SQLite file lives here (portfolio.db). Back this up.
